# Copy to config-local.yaml and fill in, or export the referenced environment variables.
#
# This config intentionally declares ONLY the `local` server. The test suite refuses to
# run unless exactly one server named `local` on localhost is configured, because it
# performs real writes — that guard is what keeps it from ever touching dev or prod.
#
# config-local.yaml is gitignored. Keep it that way.

default_server: local

servers:
  local:
    host: localhost
    port: 8000
    user: ${ML_LOCAL_USER}
    password: ${ML_LOCAL_PASSWORD}
    use_https: false
    default_permissions: "rest-reader:read"
