# Credentials per environment (referenced in config.yaml as ${VAR})
ML_DEV_USER=your-dev-username
ML_DEV_PASSWORD=your-dev-password

ML_PROD_USER=your-prod-username
ML_PROD_PASSWORD=your-prod-password

# Local instance (referenced in config-local.yaml — used by the test suite)
ML_LOCAL_USER=admin
ML_LOCAL_PASSWORD=your-local-password

# Optional: override config file location (default: config.yaml in cwd)
# ML_CONFIG_PATH=/path/to/config.yaml
